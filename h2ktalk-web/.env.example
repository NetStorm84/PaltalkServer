# Application Configuration
APP_NAME="h2ktalk.fun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP Configuration
PHP_CLI_SERVER_WORKERS=4

# Security
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Use SQLite for shared database with Node.js chat server
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database.db

# Alternative MySQL configuration (if preferred)
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=h2ktalk
# DB_USERNAME=sail
# DB_PASSWORD=password

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log

# File Storage
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION=database

# Cache Configuration
CACHE_STORE=file
# CACHE_PREFIX=

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (for production deployments)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# Chat Server Integration
# URL of the Node.js chat server for API integration
CHAT_SERVER_URL=http://localhost:3000

# Google Services Configuration
# Get these from Google Search Console and Google Analytics
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
GOOGLE_ANALYTICS_ID=

# Docker Sail Configuration
# Ports for local development
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
VITE_PORT=5173

# User and Group IDs for Docker (set automatically by Sail)
WWWUSER=1000
WWWGROUP=1000

# Development Tools
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# Production Settings (uncomment for production)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://h2ktalk.fun
# SESSION_SECURE_COOKIE=true
# MAIL_MAILER=smtp
# LOG_LEVEL=error